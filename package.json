{
  "name": "mijn-skool",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude tests/rls.integration.test.ts",
    "test:watch": "vitest",
    "test:rls": "vitest run tests/rls.integration.test.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > src/lib/types/database.ts",
    "db:verify": "node scripts/verify-migrations.mjs",
    "seed:demo": "node scripts/seed-demo.mjs",
    "db:verify-sql": "node scripts/verify-sql-setup.mjs",
    "db:verify-cjp": "node scripts/verify-cjp.mjs",
    "db:verify-crm": "node scripts/verify-crm.mjs",
    "db:verify-crm-deals": "node scripts/verify-crm-deals.mjs",
    "db:verify-crm-tijdlijn": "node scripts/verify-crm-tijdlijn.mjs",
    "db:verify-crm-contacten": "node scripts/verify-crm-contacten.mjs",
    "db:verify-crm-dashboard": "node scripts/verify-crm-dashboard.mjs",
    "db:verify-crm-fragmenten": "node scripts/verify-crm-fragmenten.mjs",
    "visueel": "node tools/harness/render.mjs && node tools/harness/shoot.mjs",
    "visueel:crm": "node tools/harness/render.mjs crm && node tools/harness/shoot.mjs crm",
    "visueel:suri": "node tools/harness/render.mjs suri && node tools/harness/shoot.mjs suri",
    "visueel:pijplijn": "node tools/harness/render.mjs pijplijn && node tools/harness/shoot.mjs pijplijn",
    "visueel:contacten": "node tools/harness/render.mjs contacten && node tools/harness/shoot.mjs contacten",
    "visueel:dashboard": "node tools/harness/render.mjs dashboard && node tools/harness/shoot.mjs dashboard",
    "visueel:fragmenten": "node tools/harness/render.mjs fragmenten && node tools/harness/shoot.mjs fragmenten",
    "db:verify-hubspot": "node scripts/verify-hubspot-opruimen.mjs",
    "auth:email-templates": "node scripts/apply-supabase-email-templates.mjs",
    "auth:email-templates:check": "node scripts/apply-supabase-email-templates.mjs --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.0.2",
    "lucide-react": "^1.34.0",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.7",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
